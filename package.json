{
  "name": "washflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm run test --prefix backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "qr:generate": "npm run qr:generate --prefix backend",
    "worker": "npm run worker --prefix backend",
    "worker:baileys": "npm run worker:baileys --prefix backend",
    "verify:live-otp": "npm run verify:live-otp --prefix backend",
    "test:layout": "node tests/run-layout-matrix.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
