{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/admin/whatsapp",
      "destination": "/admin/whatsapp/worker",
      "statusCode": 307,
      "regex": "^(?!/_next)/admin/whatsapp(?:/)?$"
    },
    {
      "source": "/admin/messages",
      "destination": "/admin/whatsapp/logs",
      "statusCode": 307,
      "regex": "^(?!/_next)/admin/messages(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http: https: ws: wss:; frame-ancestors 'none';"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path((?!revalidate).*)",
        "destination": "http://localhost:5000/api/:path*",
        "regex": "^/api(?:/((?!revalidate).*))(?:/)?$"
      },
      {
        "source": "/health",
        "destination": "http://localhost:5000/health",
        "regex": "^/health(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/client/track/[id]",
      "regex": "^/client/track/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/client/track/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/r/[code]",
      "regex": "^/r/([^/]+?)(?:/)?$",
