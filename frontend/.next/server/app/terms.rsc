16:["$","p",null,{"className":"mt-1","children":"Rewards reference authoritative price catalog IDs. Any excess weight, specialty items, or additional laundry lines beyond the promotional item are billed at standard catalog rates. Vouchers cannot be combined with other discount codes or stacked on a single booking."}]
17:["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-white mb-1","children":"4.3 Loyalty Points Program"}],["$","p",null,{"children":["Clients earn ",["$","strong",null,{"children":"10 loyalty points"}]," on every completed, paid laundry order. Loyalty points are awarded solely on the paid cash portion of an order; washes covered entirely by a reward voucher earn 0 loyalty points. Accumulating ",["$","strong",null,{"children":"100 loyalty points"}]," entitles the client to redeem one free Small Basket wash (capped at KES 300)."]}]]}]
18:["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-white mb-1","children":"4.4 Administrative Review & Fraud Prevention"}],["$","p",null,{"children":"To preserve fair play, all milestone reward entitlements undergo an administrative review and security check before a redeemable voucher is generated. WashFlow employs automated fraud detection: matching M-Pesa phone numbers, duplicate device or browser fingerprints, delivery address proximity, velocity anomalies, and circular referral rings are strictly prohibited. Referrals flagged for fraud or self-referral will be voided without compensation."}]]}]
19:["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-white mb-1","children":"4.5 Reversals & Order Cancellations"}],["$","p",null,{"children":"In the event a qualifying order is subsequently refunded, cancelled, or disputed, associated referral and loyalty points will be reversed via negative ledger entries. Any pending reward entitlement will be voided. If a voucher has already been approved or redeemed on a reversed order, the client's account will be flagged for administrative dispute resolution."}]]}]
1a:["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-white mb-1","children":"4.6 Voucher Validity, Non-Transferability & Expiry"}],["$","p",null,{"children":["Issued reward vouchers are valid for ",["$","strong",null,{"children":"90 days"}]," from the date of administrative approval. Expired vouchers cannot be reissued or reinstated. Loyalty points remain active for 12 months of account activity; inactivity exceeding 12 months may result in points expiration following advance notice. Referral points do not expire. Vouchers and points have zero cash redemption value, are non-transferable, and cannot be bartered or sold."]}]]}]
1b:["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-white mb-1","children":"4.7 Tax & Accounting Disclaimer"}],["$","p",null,{"children":"Promotional points, milestone entitlements, and vouchers constitute non-cash promotional discounts offered at WashFlow's sole discretion. Participants are solely responsible for determining any personal tax liabilities that may arise in connection with receipt or redemption of promotional discounts under the laws of Kenya."}]]}]
