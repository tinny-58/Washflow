f:["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8 text-slate-300 text-xs sm:text-sm leading-relaxed","children":[["$","section",null,{"className":"p-6 rounded-2xl bg-slate-900/60 border border-white/10 space-y-2","children":[["$","h2",null,{"className":"text-base font-bold text-white","children":"1. Service Scope & Booking"}],["$","p",null,{"children":"WashFlow provides on-demand doorstep laundry collection, washing, tumble-drying, steam pressing, and delivery across Nairobi. By scheduling a pickup online or creating an account, you agree to these Terms and Conditions."}]]}],["$","section",null,{"className":"p-6 rounded-2xl bg-slate-900/60 border border-white/10 space-y-2","children":[["$","h2",null,{"className":"text-base font-bold text-white","children":"2. Unit Pricing & Catalog Transparency"}],["$","p",null,{"children":"Prices listed on our live catalog are fixed by service tier (Everyday Basket loads, Duvet dimensions, and Floor Mat sizes). Final order amounts are confirmed upon digital booking and verified during dispatch inspection. No surprise fees or scale adjustments are introduced without customer consent."}]]}],["$","section",null,{"className":"p-6 rounded-2xl bg-slate-900/60 border border-white/10 space-y-2","children":[["$","h2",null,{"className":"text-base font-bold text-white","children":"3. Payments via M-Pesa"}],["$","p",null,{"children":"All transactions are conducted in Kenyan Shillings (KES) securely via Safaricom M-Pesa (Daraja API). Customers may complete payment upon delivery inspection or via instant STK push at booking. An official receipt is automatically generated and confirmed via WhatsApp."}]]}],["$","section",null,{"id":"rewards","className":"scroll-mt-32 p-6 sm:p-8 rounded-2xl bg-slate-900/60 border border-sky-500/20 space-y-4","children":[["$","div",null,{"className":"flex items-center gap-2 pb-2 border-b border-white/10","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/20