# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/washflow"

# Redis (BullMQ / sliding window rate limiter - falls back to Postgres/in-memory if offline)
REDIS_URL="redis://localhost:6379"

# Security & Secrets (generate with `openssl rand -hex 32`)
SESSION_SECRET="e93c12f49226cfd5958ba81247b9bfda51921c56ad4feea48231c53e02bf092e"
DEVICE_FINGERPRINT_SECRET="d7a1c3f59e2182b834e9185a86df0473918f0a382103a891f759c84e1b4d0812"

# Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Initial Admin Credentials (seeded on first run)
ADMIN_EMAIL="admin@washflow.co.ke"
ADMIN_PASSWORD="WashFlow#Admin2026!Secure"
ADMIN_NAME="WashFlow Operations"
ADMIN_PHONE="+254700000000"

# M-Pesa Daraja Payment Gateway
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="mock_daraja_consumer_key"
MPESA_CONSUMER_SECRET="mock_daraja_consumer_secret"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"

# WhatsApp Business Cloud API (Primary)
WHATSAPP_CLOUD_TOKEN="mock_meta_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_number_id"
ADMIN_NOTIFY_PHONE="+254700000000"

# Twilio (Fallback for WhatsApp / SMS OTP)
TWILIO_ACCOUNT_SID="mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_FROM_NUMBER="whatsapp:+14155238886"

# Email (Resend or SMTP)
RESEND_API_KEY="re_mock_key"
EMAIL_FROM="WashFlow <notifications@washflow.co.ke>"

# Abuse Protection & Rate Limiting (Configurable thresholds)
MAX_ACCOUNTS_PER_DEVICE=2
MAX_OPEN_BOOKINGS_PER_PHONE=2
MAX_OTP_ATTEMPTS=2
OTP_EXPIRY_MINUTES=5
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_IP_PER_MIN=10
