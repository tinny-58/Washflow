# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=5000
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/washflow"

# Redis (BullMQ queue & distributed rate limiting)
REDIS_URL="redis://localhost:6379"

# Security & Secrets (generate each with `openssl rand -hex 32`)
SESSION_SECRET="e93c12f49226cfd5958ba81247b9bfda51921c56ad4feea48231c53e02bf092e"
DEVICE_FINGERPRINT_SECRET="d7a1c3f59e2182b834e9185a86df0473918f0a382103a891f759c84e1b4d0812"
OTP_PEPPER="9b2a7c4e1f8d3a5b6c7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c"
BAILEYS_AUTH_KEY="a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"

# Google Authentication
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Cloudflare Turnstile Bot Protection
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Country Allowlist (ISO 3166-1 alpha-2, comma-separated)
ALLOWED_COUNTRY_CODES="KE"

# Super Admin Phone (Required for WhatsApp OTP step-up)
ADMIN_PHONE="+254700000000"
ADMIN_EMAIL="admin@washflow.co.ke"

# Rate Limiting & Abuse Protection
MAX_ACCOUNTS_PER_DEVICE=2
MAX_OPEN_BOOKINGS_PER_PHONE=2
MAX_OTP_ATTEMPTS=5
OTP_EXPIRY_MINUTES=5
RATE_LIMIT_OTP_PER_HOUR=3
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_IP_PER_MIN=10
