# ==============================================================================
# OTF Washflow - Environment Configuration Template (.env.example)
# Location: Embu, Kenya
# Brand: OTF Washflow (@otfwashflow)
# ==============================================================================

# Application & API Ports
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=5000
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/washflow"

# Redis (Rate limiting and queues)
REDIS_URL="redis://localhost:6379"

# Security & Secrets (generate with `openssl rand -hex 32`)
SESSION_SECRET="generate_32_byte_hex_session_secret_here"
DEVICE_FINGERPRINT_SECRET="generate_32_byte_hex_device_fingerprint_secret"
OTP_PEPPER="generate_32_byte_hex_otp_pepper_secret"
BAILEYS_AUTH_KEY="generate_32_byte_hex_baileys_auth_key_optional"

# Google Identity Services
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Cloudflare Turnstile Bot Protection
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
ALLOWED_COUNTRY_CODES="KE"

# Initial Admin Operations Credentials (Admin only)
ADMIN_EMAIL="admin@washflow.co.ke"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword2026!"
ADMIN_NAME="OTF Washflow Operations"
ADMIN_PHONE="+254700000000"
ADMIN_NOTIFY_PHONE="+254700000000"

# M-Pesa Daraja Payment Gateway
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="mock_daraja_consumer_key"
MPESA_CONSUMER_SECRET="mock_daraja_consumer_secret"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"

# ==============================================================================
# Meta WhatsApp Cloud API (Primary Messaging Provider)
# Dedicated OTF Washflow Business Number
# ==============================================================================
WHATSAPP_CLOUD_TOKEN="your_meta_system_user_permanent_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_whatsapp_business_account_id"
WHATSAPP_AUTH_TEMPLATE_NAME="authentication_otp"
WHATSAPP_AUTH_TEMPLATE_LANG="en_US"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verification_token"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_sha256_verification"
OTF_BUSINESS_PHONE="+254700000000"
OTF_BRAND_DISPLAY_NAME="OTF Washflow"
NEXT_PUBLIC_OTF_BUSINESS_PHONE="+254700000000"

# SMS Fallback (Twilio REST API - Used only if WhatsApp send fails with undeliverable error)
ENABLE_SMS_FALLBACK="false"
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+14155238886"

# Email Notifications
RESEND_API_KEY="re_mock_resend_api_key"
EMAIL_FROM="OTF Washflow <notifications@washflow.co.ke>"

# Abuse Protection & Rate Limiting Thresholds
MAX_ACCOUNTS_PER_DEVICE=2
MAX_OPEN_BOOKINGS_PER_PHONE=2
MAX_OTP_ATTEMPTS=5
OTP_EXPIRY_MINUTES=5
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_IP_PER_MIN=10
